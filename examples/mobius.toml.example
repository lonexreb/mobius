# =============================================================================
# Mobius Configuration
# =============================================================================
# This file configures experiment parameters, evaluation, and the agent loop.
# Generate with: mobius init

[project]
# Project name (string, required)
name = "my-ml-project"
# Semantic version (string, default: "0.1.0")
version = "0.1.0"

# -----------------------------------------------------------------------------
# Experiment settings
# -----------------------------------------------------------------------------
[experiment]
# Total budget in USD for all experiment runs (float, default: 20.0)
budget_usd = 50.0
# Estimated cost per experiment run in USD (float, default: 1.0)
cost_per_run = 1.0
# Shell command to execute for each experiment (string, optional)
# The command receives parameters as environment variables (see env_map below).
# command = "python train.py"
# Timeout per experiment run in seconds (int, default: 600)
timeout_secs = 600

# Target metric values. The agent stops when ALL targets are met.
# Keys must match metric names in your pipeline's JSON output.
[experiment.targets]
f1 = 0.85
precision = 0.90

# Parameter search space. Each key maps to an array of values to try.
# The agent, sweep, and suggest commands sample from this space.
# Tip: Parameters spanning >2 orders of magnitude (like learning_rate below)
# are automatically sampled in log-space by TPE and CMA-ES.
[experiment.sweep_space]
learning_rate = [0.0001, 0.001, 0.01, 0.1]
batch_size = [16, 32, 64, 128]
dropout = [0.1, 0.2, 0.3, 0.5]

# Map parameter names to environment variables passed to the command.
[experiment.env_map]
learning_rate = "TRAIN_LR"
batch_size = "TRAIN_BATCH_SIZE"
dropout = "TRAIN_DROPOUT"

# -----------------------------------------------------------------------------
# Evaluation / Benchmarking
# -----------------------------------------------------------------------------
[bench]
# Maximum time difference (seconds) to match a prediction to ground truth
# (float, default: 6.0)
match_window = 6.0
# Directory for storing evaluation run artifacts (string, default: "runs/")
store_path = "runs/"

# Scoring dimensions. Weights should sum to 1.0.
# Available scorers: "f1", "accuracy", "timestamp_mae"
[[bench.dimensions]]
name = "Detection"
weight = 0.40
scorer = "f1"

[[bench.dimensions]]
name = "Classification"
weight = 0.30
scorer = "accuracy"

[[bench.dimensions]]
name = "Timestamp"
weight = 0.30
scorer = "timestamp_mae"

# -----------------------------------------------------------------------------
# Compute backend
# -----------------------------------------------------------------------------
[compute]
# Backend type (string, default: "local")
# Currently only "local" (subprocess) is supported.
backend = "local"
# Optional GPU type hint (e.g., "A100", "T4")
# gpu_type = "A100"

# -----------------------------------------------------------------------------
# Agent loop settings
# -----------------------------------------------------------------------------
[agent]
# Strategies to use. The agent cycles through these on consecutive reverts.
# Available: "gradient_guided", "random", "grid", "tpe", "nsga2", "ucb1",
#            "cmaes", "pbt", "auto", "hyperband"
strategies = ["auto", "tpe", "gradient_guided"]
# Number of recent experiments to check for plateau (int, default: 5)
plateau_window = 5
# Minimum metric variance to consider progress (float, default: 0.02)
plateau_threshold = 0.02
# Maximum retries for failed experiments (int, default: 1)
max_retries = 2

# -----------------------------------------------------------------------------
# Strategy-specific hyperparameters (all optional, sensible defaults)
# -----------------------------------------------------------------------------
[agent.strategy_params]
# TPE: fraction of history considered "good" (float, default: 0.25)
tpe_gamma = 0.25
# CMA-ES: population size (int or omit for auto = 4 + floor(3 * ln(d)))
# cmaes_population_size = 10
# UCB1: exploration constant (float, default: sqrt(2) ~ 1.414)
# ucb1_exploration_constant = 1.414
# PBT: population size (int, default: 8)
pbt_population_size = 8
# NSGA-II: objective metrics (array of strings, default: ["f1", "precision"])
nsga_objectives = ["f1", "precision"]
# NSGA-II: population size (int, default: 20)
nsga_population_size = 20
# Hyperband: max resource/fidelity budget (int, default: 81)
hyperband_max_resource = 81
# Hyperband: reduction factor (int, default: 3, keeps top 1/eta at each rung)
hyperband_eta = 3

# Outcome constraints: experiments violating these trigger warnings.
# Useful for constrained optimization (e.g., maximize accuracy subject to latency < 100ms).
[agent.strategy_params.constraints_upper]
# latency_ms = 100.0
# memory_gb = 8.0

[agent.strategy_params.constraints_lower]
# min_accuracy = 0.50
