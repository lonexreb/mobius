[project]
name = "my-ml-project"
version = "0.1.0"

[experiment]
budget_usd = 20.0
cost_per_run = 1.0

[experiment.targets]
f1 = 0.85
precision = 0.90

[experiment.sweep_space]
learning_rate = [0.001, 0.01, 0.1]
batch_size = [16, 32, 64]

[bench]
match_window = 6.0
store_path = "runs/"

[[bench.dimensions]]
name = "Detection"
weight = 0.40
scorer = "f1"

[[bench.dimensions]]
name = "Classification"
weight = 0.30
scorer = "accuracy"

[[bench.dimensions]]
name = "Timestamp"
weight = 0.30
scorer = "timestamp_mae"

[compute]
backend = "local"

[agent]
strategies = ["parameter_tuning", "algorithm_tuning"]
plateau_window = 5
plateau_threshold = 0.02
